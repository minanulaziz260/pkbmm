# ===== Server =====
PORT=3000
NODE_ENV=development

# ===== MySQL =====
# Untuk Clever Cloud / Aiven / hosting managed lain, salin nilai dari
# dashboard provider apa adanya — DB_NAME biasanya sudah ditentukan
# (mis. "bxkfxajkbs1vbq7b2spl") dan TIDAK boleh diganti ke
# "pkbm_mugisae" karena user kamu cuma punya akses ke nama itu.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pkbm
DB_PASSWORD=changeme
DB_NAME=pkbm_mugisae

# ===== JWT =====
# Ganti dengan random string panjang di production!
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# ===== Bootstrap admin (dipakai sekali saat schema.sql dijalankan) =====
ADMIN_EMAIL=admin@mugisae.id
ADMIN_PASSWORD=demo123
